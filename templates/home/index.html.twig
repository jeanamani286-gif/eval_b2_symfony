{% extends 'base.html.twig' %}

{% block title %}Événements à venir{% endblock %}

{% block body %}
    <section class="hero" style="background-image: url('{{ asset('images/rock.jpg') }}')">
        <div class="hero-content">
            <span class="hero-kicker">Agenda local</span>
            <h1>Les événements près de chez vous</h1>
            <p>Concerts, conférences, ateliers et sport : trouvez votre prochaine sortie ou proposez la vôtre.</p>
            <a class="btn" href="{{ path('app_event_new') }}">+ Ajouter un événement</a>
        </div>
    </section>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    <div class="section-head">
        <h2>À venir</h2>
        <ul class="legend">
            <li><a class="{{ category is empty ? 'active' : '' }}" href="{{ path('app_home') }}">Toutes</a></li>
            <li class="cat-concert"><a class="{{ category == 'concert' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'concert'}) }}">Concert</a></li>
            <li class="cat-conference"><a class="{{ category == 'conference' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'conference'}) }}">Conférence</a></li>
            <li class="cat-atelier"><a class="{{ category == 'atelier' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'atelier'}) }}">Atelier</a></li>
            <li class="cat-sport"><a class="{{ category == 'sport' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'sport'}) }}">Sport</a></li>
        </ul>
    </div>

    {% set labels = {concert: 'Concert', conference: 'Conférence', atelier: 'Atelier', sport: 'Sport'} %}

    {% if events is empty %}
        <p class="empty">Aucun événement à venir pour le moment.</p>
    {% else %}
        <ul class="event-list">
            {% for event in events %}
                <li class="event-card cat-{{ event.category }}">
                    <div class="event-media">
                        {% if event.image %}
                            <img class="event-image" src="{{ asset('uploads/' ~ event.image) }}" alt="">
                        {% endif %}
                        <div class="event-date">
                            <span class="day">{{ event.date|date('d') }}</span>
                            <span class="month">{{ event.date|date('m') }}</span>
                        </div>
                        <span class="badge">{{ labels[event.category] ?? event.category }}</span>
                    </div>
                    <h3 class="event-title"><a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.title }}</a></h3>
                    <span class="muted">{{ event.date|date('d/m/Y') }} · {{ event.date|date('H\\hi') }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}