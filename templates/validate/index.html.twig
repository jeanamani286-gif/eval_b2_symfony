{% extends 'base.html.twig' %}

{% block title %}Validation des événements{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Événements à valider</h1>
            <p class="muted">{{ events|length }} événement(s) en attente de validation.</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    {% if events is empty %}
        <p class="empty">Aucun événement en attente 🎉</p>
    {% else %}
        <div class="card table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Événement</th>
                        <th>Date</th>
                        <th>Catégorie</th>
                        <th>Places</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                        <tr>
                            <td><a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.title }}</a></td>
                            <td>{{ event.date|date('d/m/Y H\\hi') }}</td>
                            <td><span class="badge cat-{{ event.category }}">{{ event.category|capitalize }}</span></td>
                            <td>{{ event.seats }}</td>
                            <td><span class="badge badge-pending">Non validé</span></td>
                            <td>
                                <form method="post" action="{{ path('app_validate_event', {id: event.id}) }}">
                                    <button type="submit" class="btn btn-small btn-success">Valider</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}