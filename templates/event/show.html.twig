{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
    {% set labels = {concert: 'Concert', conference: 'Conférence', atelier: 'Atelier', sport: 'Sport'} %}

    <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

    {% for type in ['success', 'error'] %}
        {% for message in app.flashes(type) %}
            <div class="flash flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <article class="cat-{{ event.category }}">
        <header class="detail-hero" style="background-image: url('{{ asset(event.image ? 'uploads/' ~ event.image : 'images/concert.jpg') }}')">
            <div class="detail-hero-content">
                <span class="badge">{{ labels[event.category] ?? event.category }}</span>
                <h1>{{ event.title }}</h1>
                <p>{{ event.date|date('d/m/Y') }} · {{ event.date|date('H\\hi') }}</p>
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                <p>{{ event.description|nl2br }}</p>
            </section>

            <aside class="card booking">
                {% if isFull %}
                    <p class="places"><span class="badge badge-full">Complet</span></p>
                {% else %}
                    <p class="places"><strong>{{ remaining }}</strong> places restantes sur {{ event.seats }}</p>
                {% endif %}
                <div class="progress"><span style="width: {{ percent }}%"></span></div>

                {% if not app.user %}
                    <a class="btn btn-block" href="{{ path('app_login') }}">Connectez-vous pour vous inscrire</a>
                {% elseif isRegistered %}
                    <p class="muted">Vous êtes inscrit à cet événement.</p>
                    <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}">
                        <button type="submit" class="btn btn-secondary btn-block">Se désinscrire</button>
                    </form>
                {% elseif isFull %}
                    <button class="btn btn-block" disabled>Complet</button>
                {% else %}
                    <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                        <button type="submit" class="btn btn-block">S'inscrire</button>
                    </form>
                {% endif %}
            </aside>
        </div>
    </article>
{% endblock %}